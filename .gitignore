# Python
__pycache__/
*.py[cod]
*.pyc

# DSSAT Output Files
*.OUT
*.LST
*.W?
*.T?
# Be careful with T? and W? as they might match weather/experimental files like .WTH or .TMA. 
# Better to be specific for outputs if possible, or use the standard ones.
# Standard DSSAT outputs: Overview.OUT, Summary.OUT, etc.
# But WTH and experiment files are Inputs.
# Let's ignore specific output folders or patterns.

# Workspace Run Artifacts
Workspace/Calibration_Results/
Workspace/Sensitivity_Results/
Workspace/Visualization_Results/

# PEST/DSSAT Run Generated Files
Workspace/tomato_cal.*.par
Workspace/tomato_cal.*.obs
Workspace/tomato_cal.*.pcs
Workspace/tomato_cal.*.pdc
Workspace/tomato_cal.*.rei
Workspace/tomato_cal.*.rec
Workspace/tomato_cal.*.sen
Workspace/tomato_cal.*.txt
Workspace/tomato_cal.pst
Workspace/tomato_cal.rec
Workspace/tomato_cal.log
Workspace/tomato_cal.rei
Workspace/tomato_cal.par
Workspace/tomato_cal.res
Workspace/tomato_cal.jco
Workspace/tomato_cal.unc
Workspace/tomato_cal.mtt
Workspace/tomato_cal.svd
Workspace/tomato_cal.sobs
Workspace/tomato_cal.base.par
Workspace/tomato_cal.base.rei
# Note: tomato_cal.base.par might be generated or input? The file list shows 'tomato_cal.base.par'.
# But 'TMGRO048.CUL.base' is definitely input.
# 'tomato_cal.base.par' is likely the PEST parameter file generated from template?
# Let's ignore PEST run files but keep templates (*.tpl) and instructions (*.ins).

# DSSAT Runtime Copies
Workspace/DSCSM048.EXE
Workspace/DSSAT48.INP
Workspace/DSSAT48.INH
Workspace/DSSBatch.v48
Workspace/DETAIL.OUT
Workspace/WARNING.OUT
Workspace/RunList.OUT

!Workspace/DSSBatch.v48

# Keep Source/Input Files
!Workspace/*.py
!Workspace/*.tpl
!Workspace/*.ins
!Workspace/*.base
!Workspace/*.CUL
!Workspace/*.ECO
!Workspace/*.SPE
!Workspace/*.SOL
!Workspace/*.WTH
!Workspace/*.TMA
!Workspace/*.TMT
!Workspace/*.TMX
!Workspace/*.md
!Workspace/*.csv
# Some CSVs are results, some are data.
# Results are in subfolders usually, but 'best_parameters.csv' is in Workspace root too?
# Let's ignore root CSVs that look like results.
Workspace/best_parameters.csv
Workspace/calibration_results_analysis.csv
Workspace/parameter_uncertainty_analysis.csv
Workspace/sensitivity_report_morris.csv
Workspace/tomato_cal.obs+noise.csv
Workspace/tomato_cal.phi.*.csv
Workspace/tomato_cal.adjusted.weights.csv
Workspace/tomato_cal.adjusted.obs_data.csv

# Allow original observation data if any (e.g. if there is a raw data csv)
# But based on list, data seems to be in T* files or maybe a base csv?
# 'tomato_cal.base.obs.csv' in Calibration_Results?
# Let's assume most root CSVs in Workspace are generated by the scripts.

# Binaries
*.exe
*.dll
# Exception for PEST++ tools
!pestpp-5.2.16-win/bin/*.exe
!pestpp-5.2.16-win/bin/*.dll

# OS
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/

Workspace/eggplant_stage2_v*
Workspace/eggplant_v13.*
Workspace/eggplant_v13pdc.csv
Workspace/eggplant_v13pcs.csv
!Workspace/eggplant_v13.pst
!Workspace/eggplant_v13_params.csv
!Workspace/eggplant_v13_params.csv.tpl
!Workspace/eggplant_v13_PestHarvest.OUT.ins
!Workspace/eggplant_v13_PestTmtGrow.OUT.ins

Workspace/Sensitivity_Analyze/SA_Project_Output/sen_case/
Workspace/Sensitivity_Analyze/SA_Project_Output/sen_case/**

**/_agents/

wAppDataLocalProgramsTraeresourcesappoutvsworkbenchcontribterminalcommonscripts*

