+              IF (CNC_B_IN .GT. 0.0) CNC_B = CNC_B_IN
+              IF (CNC_W0_IN .GT. 0.0) CNC_W0 = CNC_W0_IN
+              IF (CNC_NC_INF_IN .GT. 0.0) CNC_NC_INF = CNC_NC_INF_IN
+            ENDIF
+          ENDIF
+          CLOSE(LUNCRP)
+        ENDIF
+      ENDIF
+      IF (PROLFG .LE. 0.0) THEN
+        IF (PROLFI .GT. 0.0) THEN
+          PROLFG = PROLFI * 0.815
+        ELSE
+          PROLFG = 0.220
+        ENDIF
+      ENDIF
+      FNINL0 = PROLFI * 0.16
