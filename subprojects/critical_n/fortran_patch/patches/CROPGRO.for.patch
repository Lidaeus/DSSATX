         ELSEIF (MEPHO .EQ. 'C') THEN
+C         Scheme B: Dynamic NNI for photosynthetic acclimation
+          IF (WTLF .GT. 0.0) THEN
+            PCNL_C = (WTNLF / WTLF) * 100.0
+          ELSE
+            PCNL_C = 4.85
+          ENDIF
+          WEFF_C = MAX(0.001, (TOPWT + HPODWT) / 100.0)
+          IF (WEFF_C .LT. 1.00) THEN
+            NC_CUR = 4.85
+          ELSE
+            NC_CUR = 4.85 * (WEFF_C ** (-0.38))
+          ENDIF
+          IF (NC_CUR .GT. 0.0) THEN
+            NNI_CUR = PCNL_C / NC_CUR
+          ELSE
+            NNI_CUR = 1.0
+          ENDIF
           CALL PHOTO(CONTROL, 
