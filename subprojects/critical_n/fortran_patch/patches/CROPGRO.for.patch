+          LNUM = 0
+          SECTION = '!*PLAN'
+          CALL FIND(LUNCRP, SECTION, LINC, FOUND)
+          IF (FOUND .EQ. 1) THEN
+            LNUM = LNUM + LINC
+            CALL IGNORE(LUNCRP, LNUM, ISECT, C80)
+            READ(C80, '(6X,F6.0)', IOSTAT = ERRNUM) PROLFG_IN
+            IF (ERRNUM .EQ. 0 .AND. PROLFG_IN .GT. 0.0) THEN
