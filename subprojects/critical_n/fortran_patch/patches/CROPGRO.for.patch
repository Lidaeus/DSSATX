+            ENDIF
+          ENDIF
+          REWIND(LUNCRP)
+          LNUM = 0
+          SECTION = '!*CRIT'
+          CALL FIND(LUNCRP, SECTION, LINC, FOUND)
+          IF (FOUND .EQ. 1) THEN
+            LNUM = LNUM + LINC
+            CALL IGNORE(LUNCRP, LNUM, ISECT, C80)
+            READ(C80, '(4F6.0)', IOSTAT = ERRNUM) 
