+          ELSE
+            FR_DIL = 1.0
+          ENDIF
+          FNINS = PROSTF * 0.16 + (PROSTI - PROSTF) * 0.16 * FR_DIL
+          FNINS = MAX(PROSTF * 0.16, MIN(PROSTI * 0.16, FNINS))
+        ELSE
+          FNINL = PROLFI * 0.16
+          FNINS = PROSTI * 0.16
+        ENDIF
