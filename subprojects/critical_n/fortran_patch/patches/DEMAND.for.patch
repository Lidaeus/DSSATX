+C       Phase R2: Dynamic critical nitrogen dilution target
+        IF (WEFF .GT. 0.0) THEN
+          IF (WEFF .LT. 1.00) THEN
+            NC_DEM = 4.85
+          ELSE
+            NC_DEM = 1.70 + (4.85 - 1.70) * (WEFF ** (-0.38))
+          ENDIF
+          NVSTL = MAX(PROLFF * 0.16, NC_DEM / 100.0)
+          IF (FNINL .GT. PROLFF * 0.16) THEN
