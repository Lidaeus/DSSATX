+      error stop 'RNK: season end does not match the pending plant uptake'
+    ! Preserve the native season boundary. Report the pending flux without a soil mutation.
+    deducted=0
+    call NI_WRITE_ROOT_LEDGER(nlayr,0,deducted)
+  end subroutine
