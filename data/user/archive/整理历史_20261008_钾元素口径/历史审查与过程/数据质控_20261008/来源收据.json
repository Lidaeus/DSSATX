    {
      "id": "post-review-findings",
      "title": "修正后发现的指标引用和派生值问题",
      "queries": [
        {
          "id": "workbook-reference-checks",
          "source": {
            "label": "2026春源Excel",
            "files": [
              {
                "label": "2026春茎叶果氮磷钾.xlsx"
              },
              {
                "label": "2026春土壤养分数据集.xlsx"
              },
              {
                "label": "2026春品质指标集.xlsx"
              }
            ],
            "caveats": [
              "H362的指标引用错误可以确定；I362全钾真值需原测定记录确认。K30的建议值以延用其他35行统一换算口径为条件。"
            ],
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "全磷公式引用",
                "detail": "H362=F362×0.93；F362是日期20260717，公式产生18842466.81。"
              },
              {
                "kind": "validation",
                "title": "全钾公式引用",
                "detail": "I362=G362×0.93；G362为全氮29.9941329856584，结果27.8945436766623。"
              },
              {
                "kind": "validation",
                "title": "换算未同步",
                "detail": "土壤G30=189.697317685934，K30=0.726647391916647；其他35行满足G/K=391。"
              },
              {
                "kind": "validation",
                "title": "透视未刷新",
                "detail": "品质Sheet2 C19保存748.737220549698，源Sheet1 I59:I61现合计666.373408115875。"
              }
            ]
          },
          "methods": [
            {
              "language": "calculation",
              "code": "20260717 × 0.93 = 18842466.81\n29.9941329856584 × 0.93 = 27.8945436766623\n189.697317685934 / 391 = 0.4851593802709309\n225.827100142266 + 218.421838601651 + 222.124469371958 = 666.373408115875"
            }
          ]
        }
      ]
    },
