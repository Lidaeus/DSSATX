{
  "schemaVersion": 1,
  "items": [
    {
      "id": "directory-union",
      "title": "统一目录并集结果",
      "queries": [
        {
          "id": "merged-file-checks",
          "source": {
            "label": "两目录文件及合并清单",
            "files": [
              {
                "label": "逐文件合并清单.csv"
              },
              {
                "label": "合并验证结果.json"
              }
            ],
            "metricDefinitions": [
              {
                "label": "并集文件",
                "definition": "并集按相对路径配对；同名不同内容采用保存时间较新版本，双方版本另行备份。"
              }
            ],
            "caveats": [
              "195为原文件并集数，不包含本次新增报告、备份和日志；跳过依赖链接、缓存及临时锁文件。"
            ],
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "文件内容核验",
                "detail": "195个并集基础文件的SHA-256均符合所选原版本；原当前目录179个文件保持不变。"
              },
              {
                "kind": "validation",
                "title": "实验Excel可读性",
                "detail": "三季源数据目录共24份Excel，均可读取。"
              }
            ]
          },
          "columns": [
            "原当前文件",
            "原目标文件",
            "并集基础文件",
            "补入文件",
            "内容冲突",
            "同名字节一致"
          ],
          "rows": [
            {
              "原当前文件": 179,
              "原目标文件": 32,
              "并集基础文件": 195,
              "补入文件": 163,
              "内容冲突": 2,
              "同名字节一致": 14
            }
          ]
        }
      ]
    },
